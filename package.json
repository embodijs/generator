{
  "scripts": {
    "ci:publish": "pnpm publish --access public -r",
    "test:e2e:init": "pnpm run --recursive test:e2e:init",
    "test:e2e": "pnpm run --recursive test:e2e",
    "test": "vitest",
    "test:ci": "vitest --run",
    "build": "pnpm run --recursive build",
    "dev": "pnpm run --recursive dev",
    "prepublishOnly": "pnpm run --recursive prepublishOnly"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "publint": "^0.3.15",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ]
